# All optional. Planet runs with no configuration.
# Weather: "open-meteo" (free, keyless, live) or "demo" (illustrative only).
NEXT_PUBLIC_WEATHER_PROVIDER=open-meteo
# Persistence: with both Supabase values set at build time, trips sync to Supabase (anonymous per-browser identity,
# see docs/Persistence.md); with them empty the app is localStorage-only. Anon key is public by design; never put the
# service_role key here or in the app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Set to "local" to force localStorage-only even when the two variables above are set.
NEXT_PUBLIC_TRIP_REPOSITORY=
# Future, server-only (never NEXT_PUBLIC_): OPENAI_API_KEY / ANTHROPIC_API_KEY for an LLM ItineraryGenerator,
# GOOGLE_MAPS_API_KEY or MAPBOX_TOKEN for places/directions, EXCHANGE_RATE_API_KEY for currency.
