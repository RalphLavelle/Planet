# All optional. Planet runs with no configuration.
# Weather: "open-meteo" (free, keyless, live) or "demo" (illustrative only).
NEXT_PUBLIC_WEATHER_PROVIDER=open-meteo
# Trip persistence: "local" (localStorage, default). Future: "supabase" | "postgres".
NEXT_PUBLIC_TRIP_REPOSITORY=local
# Future, server-only (never NEXT_PUBLIC_): OPENAI_API_KEY / ANTHROPIC_API_KEY for an LLM ItineraryGenerator,
# GOOGLE_MAPS_API_KEY or MAPBOX_TOKEN for places/directions, EXCHANGE_RATE_API_KEY for currency.
